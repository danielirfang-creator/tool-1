{
  "name": "CraftCalc - Pinterest Automation",
  "flow": [
    {
      "id": 1,
      "module": "google-sheets:watchRows",
      "version": 2,
      "parameters": {
        "limit": 1
      },
      "mapper": {
        "chooseType": "byMapping",
        "sheet": "pinterest_180_videos_schedule",
        "tableContainsHeaders": true
      },
      "metadata": {
        "designer": {
          "x": 0,
          "y": 0,
          "name": "Google Sheets"
        }
      }
    },
    {
      "id": 2,
      "module": "pinterest:createPin",
      "version": 1,
      "parameters": {},
      "mapper": {
        "sourceType": "image_url",
        "image_url": "{{1.Cover_Image_URL}}",
        "title": "{{1.Title}}",
        "description": "{{1.Description}}",
        "link": "{{1.Destination_Link}}"
      },
      "metadata": {
        "designer": {
          "x": 300,
          "y": 0,
          "name": "Pinterest - Create a Pin"
        }
      }
    }
  ],
  "metadata": {
    "instant": false,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "sequential": false,
      "confidential": false,
      "dataloss": false,
      "dlq": false
    },
    "designer": {
      "orphans": []
    }
  }
}